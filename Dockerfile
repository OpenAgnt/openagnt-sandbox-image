# One image for small/base/turbo; only the deployment plan differs.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    HOME=/home/user \
    PNPM_HOME=/home/user/.local/share/pnpm \
    PATH=/home/user/.local/bin:/home/user/.local/node/bin:/home/user/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN for i in 1 2 3 4 5; do apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=5 update && break || sleep 5; done \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=5 install -y --no-install-recommends \
      curl ca-certificates git xz-utils unzip jq \
      build-essential pkg-config libffi-dev libssl-dev \
      python3 python3-venv python3-dev \
      ffmpeg imagemagick \
      tigervnc-standalone-server xfce4-panel xfwm4 xfdesktop4 xfce4-settings \
      xfce4-terminal dbus-x11 x11-xserver-utils x11-utils x11-xkb-utils xauth \
      fonts-dejavu-core at-spi2-core \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 -U user
WORKDIR /home/user

# Node 22
ARG NODE_VERSION=22.21.0
RUN mkdir -p /home/user/.local/node \
    && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
       | tar -xJ -C /home/user/.local/node --strip-components=1 \
    && node -v && npm -v

# Package managers + pinned agent CLIs (pnpm is dramatically faster here;
# one layer per pin so a retry resumes).
RUN npm install -g pnpm@10 bun --no-audit --no-fund --loglevel=error
RUN pnpm add -g @anthropic-ai/claude-code@2.1.304 --allow-build=@anthropic-ai/claude-code --reporter=silent
RUN pnpm add -g @charmland/crush@0.98.2 --allow-build=@charmland/crush --reporter=silent
RUN pnpm add -g @continuedev/cli@1.5.47 --allow-build=@continuedev/cli --reporter=silent
RUN pnpm add -g @deepseek-ai/dsh@0.2.1-rc.2 --allow-build=@deepseek-ai/dsh --reporter=silent
RUN pnpm add -g @earendil-works/pi-coding-agent@1.3.0 --allow-build=@earendil-works/pi-coding-agent --reporter=silent
RUN pnpm add -g @github/copilot@1.0.103 --allow-build=@github/copilot --reporter=silent
RUN pnpm add -g @moonshot-ai/kimi-code@2.3.1 --allow-build=@moonshot-ai/kimi-code --reporter=silent
RUN pnpm add -g @openai/codex@0.163.0 --allow-build=@openai/codex --reporter=silent
RUN pnpm add -g @opencode/cli@2.1.1 --allow-build=@opencode/cli --reporter=silent
RUN pnpm add -g @qwen-code/qwen-code@0.26.0 --allow-build=@qwen-code/qwen-code --reporter=silent
RUN pnpm add -g cline@3.0.73 --allow-build=cline --reporter=silent
RUN pnpm add -g command-code@1.88.1 --allow-build=command-code --reporter=silent
RUN pnpm add -g droid@0.248.0 --allow-build=droid --reporter=silent
RUN pnpm store prune || true

# --- Agents whose npm postinstall hangs in this environment (installed directly) ---
# junie: the package downloads this same release zip from its postinstall.
RUN set -eux; \
    curl -fsSL https://github.com/JetBrains/junie/releases/download/3110.7/junie-release-3110.7-linux-amd64.zip -o /tmp/junie.zip; \
    mkdir -p /opt/junie; \
    unzip -q /tmp/junie.zip -d /opt/junie; \
    chmod +x /opt/junie/junie; \
    ln -sf /opt/junie/junie /usr/local/bin/junie; \
    ln -sf /opt/junie/junie-app /usr/local/bin/junie-app; \
    rm -f /tmp/junie.zip

# kilo: platform package ships the native binary (no postinstall needed).
RUN set -eux; \
    pnpm add -g @kilocode/cli-linux-x64@7.8.18 --reporter=silent; \
    BIN="$(find /home/user/.local/share/pnpm -path '*cli-linux-x64/bin/kilo' -type f | head -1)"; \
    test -n "$BIN"; \
    mkdir -p /opt/kilo; \
    cp -a "$(dirname "$BIN")"/. /opt/kilo/; \
    chmod +x /opt/kilo/kilo; \
    ln -sf /opt/kilo/kilo /usr/local/bin/kilo

# omp: pure JS dependency tree (no postinstall); install without build flags.
RUN pnpm add -g @oh-my-pi/pi-coding-agent@18.12.6 --reporter=silent

# openclaw: postinstall build fails; the JS entrypoint works without it.
RUN pnpm add -g openclaw@2026.10.8 --reporter=silent

# reacher (check-if-email-exists) — pinned release binary.
RUN set -eux; \
    curl -fsSL https://github.com/reacherhq/check-if-email-exists/releases/download/v0.11.7/check_if_email_exists-x86_64-unknown-linux-musl.tar.gz -o /tmp/reacher.tgz; \
    tar -xzf /tmp/reacher.tgz -C /tmp; \
    install -m 0755 /tmp/check_if_email_exists /usr/local/bin/check_if_email_exists; \
    rm -f /tmp/reacher.tgz /tmp/check_if_email_exists; \
    check_if_email_exists --version

# Non-npm agents — install steps are ported from template.base.ts:
# hermes (source)
# grok (binary)
# vibe (python)
# goose (release)
# gptme (python)
# deepagents (uv)
# zcode (deb)
# fx (binary)

# Caches stay ephemeral; config lives on the volume at runtime.
RUN mkdir -p /workspace \
    && chown -R user:user /workspace /home/user /opt/junie /opt/kilo

USER user

# uv (pinned) — used to resolve gptme / vibe / deepagents cleanly.
RUN set -eux; \
    curl -fsSL https://github.com/astral-sh/uv/releases/download/0.13.6/uv-x86_64-unknown-linux-gnu.tar.gz -o /tmp/uv.tgz; \
    echo "f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645  /tmp/uv.tgz" | sha256sum -c -; \
    tar -xzf /tmp/uv.tgz -C /tmp; \
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv; \
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/uvx 2>/dev/null || true; \
    rm -rf /tmp/uv.tgz /tmp/uv-x86_64-unknown-linux-gnu; \
    uv --version

# gptme (PyPI, via uv tool env)
RUN set -eux; \
    uv tool install --python 3.12 'gptme==0.35.1'; \
    ln -sf /home/user/.local/bin/gptme /usr/local/bin/gptme; \
    ln -sf /home/user/.local/bin/gptme-util /usr/local/bin/gptme-util 2>/dev/null || true; \
    gptme --version

# vibe (PyPI, via uv tool env)
RUN set -eux; \
    uv tool install --python 3.12 'mistral-vibe==3.0.2'; \
    ln -sf /home/user/.local/bin/vibe /usr/local/bin/vibe; \
    for b in vibe-acp vibe-app-server; do ln -sf /home/user/.local/bin/$b /usr/local/bin/$b 2>/dev/null || true; done; \
    vibe --help >/dev/null

# deepagents (dcode) — requires Python 3.14, uv downloads it.
RUN set -eux; \
    uv tool install --python 3.14 'deepagents-code==0.2.2'; \
    ln -sf /home/user/.local/bin/dcode /usr/local/bin/dcode; \
    dcode --version

# goose (GitHub release)
RUN set -eux; \
    curl -fsSL https://github.com/aaif-goose/goose/releases/download/v1.56.0/goose-x86_64-unknown-linux-gnu.tar.gz -o /tmp/goose.tgz; \
    echo "225a929b35b5130fb691eafdb50be236f2c0a150019b53973775938f8f19c281  /tmp/goose.tgz" | sha256sum -c -; \
    mkdir -p /opt/goose; \
    tar -xzf /tmp/goose.tgz -C /opt/goose; \
    install -m 0755 /opt/goose/goose /usr/local/bin/goose; \
    rm -f /tmp/goose.tgz; \
    goose --version

# grok (official installer, google-storage fallback)
RUN set -eux; \
    (HOME=/home/user GROK_BIN_DIR=/home/user/.grok/bin bash -c 'curl -fsSL https://x.ai/cli/install.sh -o /tmp/grok.sh && bash /tmp/grok.sh' \
      || HOME=/home/user GROK_BIN_DIR=/home/user/.grok/bin bash -c 'curl -fsSL https://storage.googleapis.com/grok-build-public-artifacts/cli/install.sh -o /tmp/grok.sh && bash /tmp/grok.sh'); \
    ln -sf /home/user/.grok/bin/grok /usr/local/bin/grok; \
    grok --version

# fx (setup script)
RUN set -eux; \
    HOME=/home/user bash -c 'curl -fsSL https://fx.sh/setup.sh -o /tmp/fx.sh && sh /tmp/fx.sh'; \
    ln -sf /home/user/.local/bin/fx /usr/local/bin/fx; \
    fx --version

# zcode (Electron .deb: extract, keep the CLI bundle + provider config)
RUN set -eux; \
    curl -fsSL https://cdn-zcode.z.ai/zcode/electron/releases/3.16.3/linux-x64/ZCode-3.16.3-linux-x64.deb -o /tmp/zcode.deb; \
    echo "128132b195977fd0a8c8a6c295cf42fe159222d7a5c5efefd8b5f00ef88ab8b6  /tmp/zcode.deb" | sha256sum -c -; \
    mkdir -p /opt/zcode; \
    dpkg-deb -x /tmp/zcode.deb /opt/zcode; \
    mkdir -p /home/user/.local/share/zcode/provider; \
    cp /opt/zcode/opt/ZCode/resources/glm/zcode.cjs /home/user/.local/share/zcode/zcode.cjs; \
    cp /opt/zcode/opt/ZCode/resources/config/provider/zcode-builtin.json /home/user/.local/share/zcode/provider/zcode-builtin.json; \
    ZBIN="$(find /opt/zcode -type f -name zcode -perm -u+x | head -1)"; \
    test -n "$ZBIN"; \
    ln -sf "$ZBIN" /usr/local/bin/zcode; \
    chmod +x "$ZBIN"; \
    rm -f /tmp/zcode.deb; \
    zcode --version 2>&1 | head -3

# hermes (source installer, pinned commit)
RUN set -eux; \
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh -o /tmp/hermes.sh; \
    echo "abf338605dae6dd28d101673ac6aed7995c955745db46d47676bc591a7957209  /tmp/hermes.sh" | sha256sum -c -; \
    bash /tmp/hermes.sh --channel stable --branch main --commit bf0203a794a07aac3ff764972ab9087baa4e4f4e --dir /home/user/.hermes/hermes-agent --hermes-home /home/user/.hermes --non-interactive; \
    rm -f /tmp/hermes.sh; \
    ln -sf /home/user/.local/bin/hermes /usr/local/bin/hermes 2>/dev/null || true; \
    hermes --version

# Final assertion: all 25 agents + Reacher resolve by name.
RUN bash -lc 'set -e; for b in claude codex pi opencode kilo cline qwen droid omp hermes copilot dsh grok junie kimi vibe crush cn goose gptme dcode zcode fx commandcode openclaw check_if_email_exists; do command -v $b >/dev/null; done; echo ALL-25-OK'

CMD ["sleep", "infinity"]
